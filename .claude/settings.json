{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_MAX_TIMEOUT_MS": "3600000"
  }
}
