# Kabuk betikleri DAİMA LF olmalı — CRLF ile bash "\r: command not found" verir.
*.sh text eol=lf

# Markdown ve JSON: depoda LF
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf

# Windows toplu dosyaları: cmd.exe CRLF bekler
*.bat text eol=crlf

# SVG görseller: depoda LF
*.svg text eol=lf

# Çeviri katalogları (PRD 10.10.3): kaynaklar depoda LF; derlenmiş `.mo` ikilidir, dönüştürülmez
# (`python -m app.i18n check` `.mo`'yu `.po`'nun derlemesiyle bayt bayt karşılaştırır).
*.po text eol=lf
*.pot text eol=lf
*.cfg text eol=lf
*.mo binary
