# belgeee — ortam değişkeni şablonu.
# Yerel geliştirme: `cp .env.example .env` sonra değerleri doldur.
# `.env` git'e girmez (bkz. .gitignore); gerçek secret bu depoya asla commit edilmez.

# Çalışma ortamı: development | production
APP_ENV=development

# ZORUNLU. SQLAlchemy bağlantı dizesi.
# Geliştirme: sqlite:///./data/belgeee.db
# Üretim (PostgreSQL 16): postgresql+psycopg://kullanici:sifre@host:5432/belgeee
DATABASE_URL=sqlite:///./data/belgeee.db

# Çalışma zamanı veri dizini kökü (Inbox, çalışan klasörleri, arşiv). git dışı.
DATA_DIR=data
