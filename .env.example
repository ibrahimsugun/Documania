# belgeee — ortam değişkeni şablonu.
# Yerel geliştirme: `cp .env.example .env` sonra değerleri doldur.
# `.env` git'e girmez (bkz. .gitignore); gerçek secret bu depoya asla commit edilmez.

# Çalışma ortamı: development | production
APP_ENV=development

# ZORUNLU. SQLAlchemy bağlantı dizesi.
# Geliştirme: sqlite:///./data/belgeee.db
# Üretim (PostgreSQL 16): postgresql+psycopg://kullanici:sifre@host:5432/belgeee
DATABASE_URL=sqlite:///./data/belgeee.db

# Çalışma zamanı veri dizini kökü (Inbox, çalışan klasörleri, arşiv). git dışı.
DATA_DIR=data

# Yükleme başına dosya boyutu sınırı (bayt). Aşan dosya reddedilir (01.3.1). Varsayılan 20 MiB.
MAX_UPLOAD_FILE_SIZE_BYTES=20971520

# Tek bir PDF'te izin verilen en çok sayfa sayısı. Aşan dosya reddedilir (01.3.1).
MAX_UPLOAD_PDF_PAGES=30

# Analiz için PDF sayfa görüntüsü (02.1.1): sayfa bu DPI'da render edilir; görüntünün uzun
# kenarı sınırı aşarsa uzun kenar sınıra oturacak şekilde küçültülür. Önbellek JPEG kalitesi 1-100.
PAGE_RENDER_DPI=200
PAGE_RENDER_MAX_LONG_EDGE_PX=1568
PAGE_RENDER_JPEG_QUALITY=90
