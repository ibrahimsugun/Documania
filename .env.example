# Documania — ortam değişkeni şablonu.
# Yerel geliştirme: `cp .env.example .env` sonra değerleri doldur.
# `.env` git'e girmez (bkz. .gitignore); gerçek secret bu depoya asla commit edilmez.

# Çalışma ortamı: development | production
APP_ENV=development

# ZORUNLU. SQLAlchemy bağlantı dizesi.
# Geliştirme: sqlite:///./data/belgeee.db
# Üretim (PostgreSQL 16): postgresql+psycopg://kullanici:sifre@host:5432/belgeee
DATABASE_URL=sqlite:///./data/belgeee.db

# Panel, işçi ve bot açılışta veritabanının göç sürümünü koddaki son göçle karşılaştırır.
# Uyuşmazsa açılmaz ve önce `python -m alembic upgrade head` (ya da `baslat.bat`) ister (13.5.3).
# Kapatmak yalnız şemayı göçsüz kuran testler içindir. Varsayılan: true.
# STARTUP_SCHEMA_CHECK=true

# Çalışma zamanı veri dizini kökü (Inbox, çalışan klasörleri, arşiv). git dışı.
DATA_DIR=data

# Yükleme başına dosya boyutu sınırı (bayt). Aşan dosya reddedilir (01.3.1). Varsayılan 20 MiB.
MAX_UPLOAD_FILE_SIZE_BYTES=20971520

# Tek bir PDF'te izin verilen en çok sayfa sayısı. Aşan dosya reddedilir (01.3.1).
MAX_UPLOAD_PDF_PAGES=30

# Analiz için PDF sayfa görüntüsü (02.1.1): sayfa bu DPI'da render edilir; görüntünün uzun
# kenarı sınırı aşarsa uzun kenar sınıra oturacak şekilde küçültülür. Önbellek JPEG kalitesi 1-100.
PAGE_RENDER_DPI=200
PAGE_RENDER_MAX_LONG_EDGE_PX=1568
PAGE_RENDER_JPEG_QUALITY=90
# Metin katmanı olan PDF sayfası (13.2.2): yazı analize metin olarak da gittiği için görüntü bu
# daha düşük uzun kenar sınırıyla render edilir. Genel sınırdan büyükse genel sınır geçerlidir.
PAGE_RENDER_TEXT_LAYER_MAX_LONG_EDGE_PX=1024

# `render_image` çıktısı (07.6.1, §20.5): gömülü görüntü yoksa son çare olarak sayfa bu DPI'da
# rasterleştirilir ve bu JPEG kalitesiyle yayınlanır. Analiz önbelleğinin (yukarıdaki PAGE_RENDER_*)
# ayarından bağımsızdır.
RENDER_IMAGE_DPI=200
RENDER_IMAGE_JPEG_QUALITY=90

# Sayfa analizi yapay zekâ sağlayıcısı (03.2.1). Değiştirmek için yalnız bu değer değişir;
# seçilen sağlayıcının anahtarı ve modeli aşağıdaki kendi değişkenlerinden okunur.
AI_PROVIDER=anthropic
# Sayfa başına yanıt için en çok çıktı token'ı; aşılırsa yanıt kesik sayılır ve reddedilir.
AI_MAX_OUTPUT_TOKENS=4096
# Tek sağlayıcı isteği için zaman aşımı (saniye).
AI_REQUEST_TIMEOUT_SECONDS=120

# Anthropic sağlayıcısı (03.2.2). Anahtar yalnız AI_PROVIDER=anthropic iken zorunludur.
# Gerçek anahtar yalnız yerel .env'e yazılır; bu dosyada boş kalır.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Ucuz model ön elemesi (13.2.1): tanımlıysa her sayfa önce bu modele sorulur; türü belli, zorunlu
# alanları okunaklı, notsuz ve kimlik numarası MRZ kontrol haneleriyle doğrulanan sayfa onda kalır,
# gerisi ANTHROPIC_MODEL'e yeniden sorulur. Boşsa ön eleme yapılmaz (varsayılan).
# ANTHROPIC_PRESCREEN_MODEL=claude-haiku-4-5

# OpenAI sağlayıcısı (03.3.1, ikincil). Anahtar yalnız AI_PROVIDER=openai iken zorunludur.
# Gerçek anahtar yalnız yerel .env'e yazılır; bu dosyada boş kalır.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Ucuz model ön elemesi (13.2.1), ANTHROPIC_PRESCREEN_MODEL gibi; boşsa yapılmaz.
# OPENAI_PRESCREEN_MODEL=

# Analiz talimatındaki katalog metninin token bütçesi (11.4.3, tahmini token). AYAR GEREKMEZ: boşsa
# bütçe aktif analiz edilen tür sayısıyla ölçeklenir — max(4000, 200 × tür sayısı) — ve her türün
# tanımı kesilmeden girer. Verilirse aynen kullanılır; metin sığmazsa önce tanımlar kısaltılır
# (11.4.2). Belge Türleri sayfası aktif tür sayısını, tahmini tokenı ve kesilen türleri gösterir.
# CATALOG_TOKEN_BUDGET=

# Kalıcı işçi kuyruğu (13.3.1): APP yalnız HTTP sunar; ayrı `worker` Compose servisi `python -m
# app.worker` ile kuyruğu işler. Her iki süreç aynı veritabanını ve kalıcı veri hacmini kullanır.
# Geliştirmede `docker compose up` worker'ı da başlatır; yalnız işçiyi durdurmak için
# `docker compose stop worker` kullanın. İşi alan worker kirasını yeniler; kirası dolan iş yeniden
# alınır, kirası WORKER_MAX_ATTEMPTS kez dolan partiden vazgeçilir (failed).
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=5

# İzleme ve uyarı (13.6.1): hata, disk doluluğu ve kuyruk uzunluğu eşiği aşınca uyarı üretilir —
# worker sürecinin logunda ("Uyarı — …"). Telegram'a gitmez (12.1.9: bot teknik mesaj göndermez).
# Son ALERT_ERROR_WINDOW_MINUTES dakikada ALERT_ERROR_COUNT parti işlenemediyse hata; veri diski
# ALERT_DISK_USED_PERCENT yüzde dolduysa disk; işlenmeyi bekleyen parti sayısı
# ALERT_JOB_QUEUE_LENGTH'e, karar bekleyen kuyruk öğesi sayısı ALERT_REVIEW_QUEUE_LENGTH'e vardıysa
# kuyruk uyarısı çıkar. Ölçüm ALERT_CHECK_SECONDS aralıkla yapılır, süren uyarı ALERT_REPEAT_MINUTES
# dakikada bir hatırlatılır, eşiğin %90'ının altına inince "giderildi" mesajı gider.
ALERT_ERROR_COUNT=3
ALERT_ERROR_WINDOW_MINUTES=60
ALERT_DISK_USED_PERCENT=85
ALERT_JOB_QUEUE_LENGTH=20
ALERT_REVIEW_QUEUE_LENGTH=50
ALERT_CHECK_SECONDS=60
ALERT_REPEAT_MINUTES=360

# Panel oturumunun ömrü (saniye, 10.1.2): süre dolunca yeniden giriş istenir. Varsayılan 12 saat.
# İlk yönetici komut satırından açılır: `python -m app.web create-admin --username <ad>` (10.1.3).
SESSION_MAX_AGE_SECONDS=43200

# Panelin açılış dili (10.10.1): en (English) | tr (Türkçe) | sr (Srpski, Latin alfabesi). Giriş
# sayfası ve dil tercihi olmayan hesaplar bu dilde açılır; tarayıcının dil ayarı kullanılmaz.
# Geçersiz değerle panel açılmaz. AYAR GEREKMEZ: varsayılan en.
# PANEL_DEFAULT_LANGUAGE=en

# Eğitim modu "Harita yükle" (11.9.5): CSV haritasının bayt sınırı ve satır sınırı (satır sınırı
# haritanın çözdüğü dosya sayısına da uygulanır). Varsayılanlar yeterlidir; AYAR GEREKMEZ.
TRAINING_MAP_MAX_BYTES=8388608
TRAINING_MAP_MAX_ROWS=20000
# İsteğe bağlı: haritanın `source_collection_path` sütununun kökü (örnek toplayıcının koleksiyon
# klasörü). Boşsa (varsayılan) o sütunun satırları "koleksiyon kökü ayarlı değil" gerekçesiyle
# atlanır; `dest`, `output_relative_path`, `ornek_klasoru` ve `path` sütunları DATA_DIR altında
# çözülür. Yollar yalnız bu köklerin altında, göreli olarak çözülür.
# TRAINING_COLLECTION_DIR=

# Telegram botu (12.1.1, K13: yalnız İK). Bot ayrı süreçtir: `python -m app.telegram.bot`
# (Compose'ta `docker compose --profile telegram up bot`). APP_ENV=development iken polling,
# production iken webhook çalışır. Beyaz liste `telegram_users` tablosudur (12.1.2).
# Gerçek token yalnız yerel .env'e yazılır; bu dosyada boş kalır. ZORUNLU (bot çalışacaksa).
# Yerelde `baslat.bat` bu token doluysa botu panelle birlikte ayrı pencerede açar (12.1.5);
# token BotFather'da `/newbot` ile alınır, yazıldıktan sonra `baslat.bat` yeniden çalıştırılır.
TELEGRAM_BOT_TOKEN=
# Yalnız APP_ENV=production: Telegram'ın çağıracağı genel https adresi (yol kısmı dinlenen yoldur).
TELEGRAM_WEBHOOK_URL=
# Yalnız APP_ENV=production, ZORUNLU: webhook isteğinin Telegram'dan geldiğini doğrulayan gizli değer
# (1-256 karakter; harf, rakam, _ ve -). Bu değer olmadan webhook açılmaz.
TELEGRAM_WEBHOOK_SECRET=
# Webhook dinleyicisi (TLS'i ters vekil sonlandırır). Konteynerde 0.0.0.0 verilir.
TELEGRAM_WEBHOOK_LISTEN=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8443

# Yedekleme (13.4.2): `scripts/backup.sh` (gece yedeği) ve `scripts/restore.sh` bu değişkenleri
# ortamdan ya da bu dosyadan okur; uygulama okumaz. Prosedür: docs/YEDEKLEME.md.
# BACKUP_DIR=backups
# BACKUP_KEEP_DAYS=14
# Sunucu dışı kopya (üretimde en az biri tanımlı olmalı):
# BACKUP_COPY_DIR=/mnt/yedek-paylasimi/belgeee
# BACKUP_SCP_TARGET=yedek@yedek-sunucusu:/srv/yedek/belgeee

# Üretim dağıtımı (13.5.1): alan adı + HTTPS, tek komut → `docker compose --profile production up -d --build`
# (README.md "Üretim dağıtımı"). Aşağıdakileri Docker Compose okur; uygulama okumaz. Sunucudaki `.env`'de
# satırların başındaki # kaldırılır ve yukarıdaki APP_ENV=production yapılır. Değerler bu dosyada
# ÖRNEKTİR; gerçek alan adı, e-posta ve parola yalnız sunucudaki `.env`'e yazılır.
# `preflight` adımı eksik ya da tutarsız değerde `up`'ı anlaşılır bir hata ile durdurur.
#
# Alan adı: DNS A/AAAA kaydı bu sunucuyu göstermeli, 80 ve 443 dışarıya açık olmalı. HTTPS
# sertifikasını Caddy kendisi alır ve yeniler.
# DOMAIN=belge.example.com
# Sertifika süresi/iptal uyarılarının gideceği adres.
# ACME_EMAIL=ik@example.com
# PostgreSQL 16 (`db` servisi) parolası. URL içinde kullanıldığı için yalnız harf ve rakam:
# `openssl rand -hex 24`. Bu dosya dışında hiçbir yere yazılmaz.
# POSTGRES_PASSWORD=degistir-openssl-rand-hex-24-ciktisi
# Konteynerlerdeki uygulamanın (panel, işçi kuyruğu, bot) veritabanı: `db` servisi + yukarıdaki parola.
# (`DATABASE_URL` adı kasten kullanılmaz: geliştirme .env'indeki SQLite yolu konteynere geçmesin.)
# APP_DATABASE_URL=postgresql+psycopg://belgeee:degistir-openssl-rand-hex-24-ciktisi@db:5432/belgeee
# Telegram botu (`--profile telegram`) webhook adresi verilmezse https://<DOMAIN>/telegram/webhook olur.
# Verilirse yolu /telegram/ ile başlamalı: Caddy yalnız bu yolu bota yönlendirir.
#
# Sunucudaki gece yedeği (scripts/backup.sh) `db` servisine bu makineden bağlanır (docker-compose.yml
# 127.0.0.1:5432'yi yayınlar) ve veri hacminin diskteki yerini okur — docs/YEDEKLEME.md "Docker Compose
# üretim dağıtımında". Bu iki satır yalnız yedek betiği içindir; konteynerlere geçmez:
# DATABASE_URL=postgresql://belgeee:degistir-openssl-rand-hex-24-ciktisi@127.0.0.1:5432/belgeee
# DATA_DIR=/var/lib/docker/volumes/belgeee_data/_data
